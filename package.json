{
  "name": "auto-test-playwright",
  "version": "1.0.1",
  "description": "MyTV automated test desktop runner",
  "main": "app/main.js",
  "scripts": {
    "app:dev": "node scripts/run-electron-app.js",
    "app:build": "electron-builder",
    "app:build:mac": "electron-builder --mac",
    "app:build:mac:dmg": "electron-builder --mac dmg",
    "app:build:win": "electron-builder --win",
    "browsers:install": "node scripts/install-playwright-browsers.js",
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:tv:contract": "node --test tests/run-test-case-tv.spec.js",
    "test:headed": "node scripts/run-headed.js",
    "tv:poc:tizen:setup": "node scripts/real-tv-appium/tizen-poc.js setup",
    "tv:poc:tizen:doctor": "node scripts/real-tv-appium/tizen-poc.js doctor",
    "tv:poc:tizen:pair": "node scripts/real-tv-appium/tizen-poc.js pair",
    "tv:poc:tizen": "node scripts/real-tv-appium/tizen-poc.js",
    "tv:poc:lg": "node scripts/real-tv-appium/lg-webos-poc.js",
    "tv:gate:lg": "node scripts/real-tv-appium/lg-webos-case-runner.js",
    "tv:compatibility:lg": "node scripts/real-tv-appium/lg-device-compatibility-check.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "appium": "2.19.0",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "vn.mytv.autotest",
    "productName": "MyTV Auto Test",
    "asar": false,
    "files": [
      "app/**/*",
      "tests/**/*",
      "DEVICE-COMPATIBILITY.json",
      "testcased.json",
      "playwright.config.js",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
